    <string name="import_guide_title_for_browser">Import %1$s bookmarks</string>
    <string name="import_guide_step1_title">1. Export on desktop Chrome</string>
    <string name="import_guide_step1_body_notice">On mobile Chrome, bookmark export is not available.</string>
    <string name="import_guide_step1_body_desktop">On your computer Chrome, open menu (⋮) > Bookmarks and lists > Bookmark manager, then menu (⋮) > Export bookmarks.</string>
    <string name="import_guide_step1_body">On mobile Chrome, bookmark export is not available. On your computer Chrome, open menu (⋮) > Bookmarks and lists > Bookmark manager, then menu (⋮) > Export bookmarks.</string>
    <string name="import_guide_step1_button">Open browser guide</string>
    <string name="import_guide_step1_title_brave">1. Open Brave bookmarks directly</string>
    <string name="import_guide_step1_body_notice_brave">Brave on mobile supports bookmark import and export.</string>
    <string name="import_guide_step1_title_edge">1. Open Microsoft Edge favourites guide</string>
    <string name="import_guide_step1_body_notice_edge">On mobile Edge, bookmark export may not be available.</string>
    <string name="import_guide_step1_body_desktop_edge">Follow Microsoft Edge favourites guide. If needed, use Favourites manager (⋯) to export favourites as HTML.</string>
    <string name="import_guide_step1_title_naver_whale">1. Set up Naver Whale sync first</string>
    <string name="import_guide_step1_body_notice_naver_whale">Official Naver Whale documentation focuses on bookmark sync across devices.</string>
    <string name="import_guide_step1_body_desktop_naver_whale">Follow Whale sync guide, then check desktop Whale bookmark manager for HTML export options.</string>
    <string name="import_guide_step1_title_samsung_internet">1. Open Samsung Internet bookmark guide</string>
    <string name="import_guide_step1_body_notice_samsung_internet">Samsung Internet may not provide direct mobile HTML bookmark export.</string>
    <string name="import_guide_step1_body_desktop_samsung_internet">Use Samsung Internet bookmark/sync guide, then export from a desktop browser if needed.</string>
    <string name="import_guide_step1_title_firefox">1. Export on desktop Firefox</string>
    <string name="import_guide_step1_body_notice_firefox">On mobile Firefox, bookmark export may not be available.</string>
    <string name="import_guide_step1_body_desktop_firefox">On your computer Firefox, open Bookmarks > Manage bookmarks, then Import and Backup > Export Bookmarks to HTML.</string>
    <string name="import_guide_step1_title_safari">1. Export on Mac Safari</string>
    <string name="import_guide_step1_body_notice_safari">On iPhone/iPad Safari, direct bookmark export is not available.</string>
    <string name="import_guide_step1_body_desktop_safari">On Mac Safari, open File > Export > Bookmarks.</string>
    <string name="import_guide_step1_title_opera">1. Export on desktop Opera</string>
    <string name="import_guide_step1_body_notice_opera">On mobile Opera, bookmark export may not be available.</string>
    <string name="import_guide_step1_body_desktop_opera">On your computer Opera, open Bookmarks manager and use Export bookmarks to HTML.</string>
    <string name="import_guide_step1_title_vivaldi">1. Export on desktop Vivaldi</string>
    <string name="import_guide_step1_body_notice_vivaldi">On mobile Vivaldi, bookmark export may not be available.</string>
    <string name="import_guide_step1_body_desktop_vivaldi">On your computer Vivaldi, open Bookmarks manager and export bookmarks as HTML.</string>
    <string name="import_guide_step1_title_duckduckgo">1. Set up DuckDuckGo Sync and Backup</string>
    <string name="import_guide_step1_body_notice_duckduckgo">DuckDuckGo official guide focuses on sync/backup rather than HTML export.</string>
    <string name="import_guide_step1_body_desktop_duckduckgo">Use DuckDuckGo sync guide, then move bookmarks through another desktop browser if HTML export is needed.</string>
    <string name="import_guide_step1_title_kiwi">1. Prepare Kiwi bookmarks for export</string>
    <string name="import_guide_step1_body_notice_kiwi">Official Kiwi documentation for bookmark HTML export is limited.</string>
    <string name="import_guide_step1_body_desktop_kiwi">Move bookmarks to a desktop Chromium-based browser, then export bookmarks as HTML.</string>
    <string name="import_guide_step1_title_yandex">1. Export on desktop Yandex Browser</string>
    <string name="import_guide_step1_body_notice_yandex">On mobile Yandex Browser, bookmark export may not be available.</string>
    <string name="import_guide_step1_body_desktop_yandex">On your computer Yandex Browser, open Bookmarks manager and export bookmarks as HTML.</string>
    <string name="import_guide_step1_title_arc">1. Follow Arc import/migration guide</string>
    <string name="import_guide_step1_body_notice_arc">Arc official guide is focused on importing data from other browsers.</string>
    <string name="import_guide_step1_body_desktop_arc">Use Arc migration guide first. If HTML export is required, move data to a browser that supports HTML export.</string>
    <string name="import_guide_step1_title_ie">1. Export favourites on Internet Explorer</string>
    <string name="import_guide_step1_body_notice_ie">Internet Explorer is deprecated and may not be available on your device.</string>
    <string name="import_guide_step1_body_desktop_ie">In Internet Explorer, open Favourites > Import and Export, then export favourites to a file.</string>
    <string name="import_guide_step1_title_generic">1. Export bookmarks on desktop %1$s</string>
    <string name="import_guide_step1_body_notice_generic">On mobile %1$s, bookmark export may not be available.</string>
    <string name="import_guide_step1_body_desktop_generic">On your computer %1$s, find Bookmark/Favourites manager and export to HTML.</string>

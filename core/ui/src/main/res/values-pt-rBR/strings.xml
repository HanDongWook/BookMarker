    <string name="import_guide_step1_title">1. Exportar no Chrome para desktop</string>
    <string name="import_guide_step1_body_notice">No Chrome para celular, a exportação de favoritos não está disponível.</string>
    <string name="import_guide_step1_body_desktop">No Chrome do seu computador, abra Menu (⋮) > Favoritos e listas > Gerenciador de favoritos, depois Menu (⋮) > Exportar favoritos.</string>
    <string name="import_guide_step1_body">No Chrome para celular, a exportação de favoritos não está disponível. No Chrome do seu computador, abra Menu (⋮) > Favoritos e listas > Gerenciador de favoritos, depois Menu (⋮) > Exportar favoritos.</string>
    <string name="import_guide_step1_button">Abrir guia do navegador</string>
    <string name="import_guide_step1_title_brave">1. Abrir favoritos do Brave diretamente</string>
    <string name="import_guide_step1_body_notice_brave">O Brave no celular suporta importação e exportação de favoritos.</string>
    <string name="import_guide_step1_title_edge">1. Abrir guia de favoritos do Microsoft Edge</string>
    <string name="import_guide_step1_body_notice_edge">No Edge para celular, a exportação de favoritos pode não estar disponível.</string>
    <string name="import_guide_step1_body_desktop_edge">Siga o guia de favoritos do Microsoft Edge. Se necessário, use o Gerenciador de favoritos (⋯) para exportar favoritos como HTML.</string>
    <string name="import_guide_step1_title_naver_whale">1. Configure primeiro a sincronização do Naver Whale</string>
    <string name="import_guide_step1_body_notice_naver_whale">A documentação oficial do Naver Whale foca na sincronização de favoritos entre dispositivos.</string>
    <string name="import_guide_step1_body_desktop_naver_whale">Siga o guia de sincronização do Whale e depois verifique o gerenciador de favoritos do Whale no desktop para opções de exportação HTML.</string>
    <string name="import_guide_step1_title_samsung_internet">1. Abrir guia de favoritos do Samsung Internet</string>
    <string name="import_guide_step1_body_notice_samsung_internet">O Samsung Internet pode não oferecer exportação direta de favoritos HTML no celular.</string>
    <string name="import_guide_step1_body_desktop_samsung_internet">Use o guia de favoritos/sincronização do Samsung Internet e, se necessário, exporte a partir de um navegador desktop.</string>
    <string name="import_guide_step1_title_firefox">1. Exportar no Firefox para desktop</string>
    <string name="import_guide_step1_body_notice_firefox">No Firefox para celular, a exportação de favoritos pode não estar disponível.</string>
    <string name="import_guide_step1_body_desktop_firefox">No Firefox do seu computador, abra Favoritos > Gerenciar favoritos, depois Importar e backup > Exportar favoritos para HTML.</string>
    <string name="import_guide_step1_title_safari">1. Exportar no Safari para Mac</string>
    <string name="import_guide_step1_body_notice_safari">No Safari de iPhone/iPad, a exportação direta de favoritos não está disponível.</string>
    <string name="import_guide_step1_body_desktop_safari">No Safari para Mac, abra Arquivo > Exportar > Favoritos.</string>
    <string name="import_guide_step1_title_opera">1. Exportar no Opera para desktop</string>
    <string name="import_guide_step1_body_notice_opera">No Opera para celular, a exportação de favoritos pode não estar disponível.</string>
    <string name="import_guide_step1_body_desktop_opera">No Opera do seu computador, abra o Gerenciador de favoritos e use Exportar favoritos para HTML.</string>
    <string name="import_guide_step1_title_vivaldi">1. Exportar no Vivaldi para desktop</string>
    <string name="import_guide_step1_body_notice_vivaldi">No Vivaldi para celular, a exportação de favoritos pode não estar disponível.</string>
    <string name="import_guide_step1_body_desktop_vivaldi">No Vivaldi do seu computador, abra o Gerenciador de favoritos e exporte favoritos como HTML.</string>
    <string name="import_guide_step1_title_duckduckgo">1. Configurar sincronização e backup do DuckDuckGo</string>
    <string name="import_guide_step1_body_notice_duckduckgo">O guia oficial do DuckDuckGo foca em sincronização/backup em vez de exportação HTML.</string>
    <string name="import_guide_step1_body_desktop_duckduckgo">Use o guia de sincronização do DuckDuckGo e depois mova os favoritos por outro navegador de desktop caso precise de exportação HTML.</string>
    <string name="import_guide_step1_title_kiwi">1. Preparar favoritos do Kiwi para exportação</string>
    <string name="import_guide_step1_body_notice_kiwi">A documentação oficial do Kiwi para exportação de favoritos em HTML é limitada.</string>
    <string name="import_guide_step1_body_desktop_kiwi">Mova os favoritos para um navegador de desktop baseado em Chromium e exporte como HTML.</string>
    <string name="import_guide_step1_title_yandex">1. Exportar no Yandex Browser para desktop</string>
    <string name="import_guide_step1_body_notice_yandex">No Yandex Browser para celular, a exportação de favoritos pode não estar disponível.</string>
    <string name="import_guide_step1_body_desktop_yandex">No Yandex Browser do seu computador, abra o Gerenciador de favoritos e exporte favoritos como HTML.</string>
    <string name="import_guide_step1_title_arc">1. Seguir o guia de importação/migração do Arc</string>
    <string name="import_guide_step1_body_notice_arc">O guia oficial do Arc é focado em importar dados de outros navegadores.</string>
    <string name="import_guide_step1_body_desktop_arc">Use primeiro o guia de migração do Arc. Se precisar de exportação HTML, mova os dados para um navegador que suporte essa opção.</string>
    <string name="import_guide_step1_title_ie">1. Exportar favoritos no Internet Explorer</string>
    <string name="import_guide_step1_body_notice_ie">O Internet Explorer está obsoleto e pode não estar disponível no seu dispositivo.</string>
    <string name="import_guide_step1_body_desktop_ie">No Internet Explorer, abra Favoritos > Importar e exportar e exporte os favoritos para um arquivo.</string>
    <string name="import_guide_step1_title_generic">1. Exportar favoritos no %1$s para desktop</string>
    <string name="import_guide_step1_body_notice_generic">No %1$s para celular, a exportação de favoritos pode não estar disponível.</string>
    <string name="import_guide_step1_body_desktop_generic">No %1$s do seu computador, encontre o Gerenciador de Favoritos/Marcadores e exporte para HTML.</string>

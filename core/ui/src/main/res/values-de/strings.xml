    <string name="import_guide_step1_title">1. Auf Desktop-Chrome exportieren</string>
    <string name="import_guide_step1_body_notice">Auf mobilem Chrome ist der Lesezeichenexport nicht verfügbar.</string>
    <string name="import_guide_step1_body_desktop">Öffnen Sie auf Ihrem Computer in Chrome Menü (⋮) > Bookmarks and lists > Bookmark manager, dann Menü (⋮) > Export bookmarks.</string>
    <string name="import_guide_step1_body">Auf mobilem Chrome ist der Lesezeichenexport nicht verfügbar. Öffnen Sie auf Ihrem Computer in Chrome Menü (⋮) > Bookmarks and lists > Bookmark manager, dann Menü (⋮) > Export bookmarks.</string>
    <string name="import_guide_step1_button">Browser-Anleitung öffnen</string>
    <string name="import_guide_step1_title_brave">1. Brave-Lesezeichen direkt öffnen</string>
    <string name="import_guide_step1_body_notice_brave">Brave auf Mobilgeräten unterstützt Lesezeichenimport und -export.</string>
    <string name="import_guide_step1_title_edge">1. Microsoft-Edge-Favoritenanleitung öffnen</string>
    <string name="import_guide_step1_body_notice_edge">Auf mobilem Edge ist der Lesezeichenexport möglicherweise nicht verfügbar.</string>
    <string name="import_guide_step1_body_desktop_edge">Folgen Sie der Microsoft-Edge-Favoritenanleitung. Falls nötig, verwenden Sie den Favorites manager (⋯), um Favoriten als HTML zu exportieren.</string>
    <string name="import_guide_step1_title_naver_whale">1. Zuerst Naver-Whale-Synchronisierung einrichten</string>
    <string name="import_guide_step1_body_notice_naver_whale">Die offizielle Naver-Whale-Dokumentation konzentriert sich auf die Synchronisierung von Lesezeichen zwischen Geräten.</string>
    <string name="import_guide_step1_body_desktop_naver_whale">Folgen Sie der Whale-Synchronisierungsanleitung und prüfen Sie anschließend im Desktop-Whale-Lesezeichenmanager die HTML-Exportoptionen.</string>
    <string name="import_guide_step1_title_samsung_internet">1. Samsung-Internet-Lesezeichenanleitung öffnen</string>
    <string name="import_guide_step1_body_notice_samsung_internet">Samsung Internet bietet auf Mobilgeräten möglicherweise keinen direkten HTML-Lesezeichenexport.</string>
    <string name="import_guide_step1_body_desktop_samsung_internet">Nutzen Sie die Samsung-Internet-Lesezeichen-/Synchronisierungsanleitung und exportieren Sie bei Bedarf über einen Desktop-Browser.</string>
    <string name="import_guide_step1_title_firefox">1. Auf Desktop-Firefox exportieren</string>
    <string name="import_guide_step1_body_notice_firefox">Auf mobilem Firefox ist der Lesezeichenexport möglicherweise nicht verfügbar.</string>
    <string name="import_guide_step1_body_desktop_firefox">Öffnen Sie auf Ihrem Computer in Firefox Bookmarks > Manage bookmarks, dann Import and Backup > Export Bookmarks to HTML.</string>
    <string name="import_guide_step1_title_safari">1. Auf Mac-Safari exportieren</string>
    <string name="import_guide_step1_body_notice_safari">Auf iPhone/iPad-Safari ist der direkte Lesezeichenexport nicht verfügbar.</string>
    <string name="import_guide_step1_body_desktop_safari">Öffnen Sie in Mac-Safari File > Export > Bookmarks.</string>
    <string name="import_guide_step1_title_opera">1. Auf Desktop-Opera exportieren</string>
    <string name="import_guide_step1_body_notice_opera">Auf mobilem Opera ist der Lesezeichenexport möglicherweise nicht verfügbar.</string>
    <string name="import_guide_step1_body_desktop_opera">Öffnen Sie auf Ihrem Computer in Opera den Bookmarks manager und nutzen Sie Export bookmarks to HTML.</string>
    <string name="import_guide_step1_title_vivaldi">1. Auf Desktop-Vivaldi exportieren</string>
    <string name="import_guide_step1_body_notice_vivaldi">Auf mobilem Vivaldi ist der Lesezeichenexport möglicherweise nicht verfügbar.</string>
    <string name="import_guide_step1_body_desktop_vivaldi">Öffnen Sie auf Ihrem Computer in Vivaldi den Bookmarks manager und exportieren Sie Lesezeichen als HTML.</string>
    <string name="import_guide_step1_title_duckduckgo">1. DuckDuckGo-Sync und Backup einrichten</string>
    <string name="import_guide_step1_body_notice_duckduckgo">Die offizielle DuckDuckGo-Anleitung konzentriert sich eher auf Synchronisierung/Backup als auf HTML-Export.</string>
    <string name="import_guide_step1_body_desktop_duckduckgo">Nutzen Sie die DuckDuckGo-Synchronisierungsanleitung und übertragen Sie Lesezeichen bei Bedarf über einen anderen Desktop-Browser für den HTML-Export.</string>
    <string name="import_guide_step1_title_kiwi">1. Kiwi-Lesezeichen für den Export vorbereiten</string>
    <string name="import_guide_step1_body_notice_kiwi">Die offizielle Kiwi-Dokumentation für den HTML-Lesezeichenexport ist begrenzt.</string>
    <string name="import_guide_step1_body_desktop_kiwi">Verschieben Sie Lesezeichen in einen Chromium-basierten Desktop-Browser und exportieren Sie sie als HTML.</string>
    <string name="import_guide_step1_title_yandex">1. Auf Desktop-Yandex-Browser exportieren</string>
    <string name="import_guide_step1_body_notice_yandex">Auf mobilem Yandex Browser ist der Lesezeichenexport möglicherweise nicht verfügbar.</string>
    <string name="import_guide_step1_body_desktop_yandex">Öffnen Sie auf Ihrem Computer im Yandex Browser den Bookmarks manager und exportieren Sie Lesezeichen als HTML.</string>
    <string name="import_guide_step1_title_arc">1. Arc-Import-/Migrationsanleitung folgen</string>
    <string name="import_guide_step1_body_notice_arc">Die offizielle Arc-Anleitung konzentriert sich auf den Import von Daten aus anderen Browsern.</string>
    <string name="import_guide_step1_body_desktop_arc">Nutzen Sie zuerst die Arc-Migrationsanleitung. Wenn HTML-Export erforderlich ist, verschieben Sie die Daten in einen Browser mit HTML-Export.</string>
    <string name="import_guide_step1_title_ie">1. Favoriten in Internet Explorer exportieren</string>
    <string name="import_guide_step1_body_notice_ie">Internet Explorer ist veraltet und auf Ihrem Gerät möglicherweise nicht verfügbar.</string>
    <string name="import_guide_step1_body_desktop_ie">Öffnen Sie in Internet Explorer Favorites > Import and Export und exportieren Sie Favoriten in eine Datei.</string>
    <string name="import_guide_step1_title_generic">1. Lesezeichen auf Desktop-%1$s exportieren</string>
    <string name="import_guide_step1_body_notice_generic">Auf mobilem %1$s ist der Lesezeichenexport möglicherweise nicht verfügbar.</string>
    <string name="import_guide_step1_body_desktop_generic">Suchen Sie auf Ihrem Computer in %1$s den Bookmark/Favorites manager und exportieren Sie nach HTML.</string>

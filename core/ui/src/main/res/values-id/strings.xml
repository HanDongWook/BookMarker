    <string name="import_guide_step1_button">Buka panduan browser</string>
    <string name="import_guide_step1_title_brave">1. Buka bookmark Brave langsung</string>
    <string name="import_guide_step1_body_notice_brave">Brave di seluler mendukung impor dan ekspor bookmark.</string>
    <string name="import_guide_step1_title_edge">1. Buka panduan favorit Microsoft Edge</string>
    <string name="import_guide_step1_body_notice_edge">Di Edge seluler, ekspor bookmark mungkin tidak tersedia.</string>
    <string name="import_guide_step1_body_desktop_edge">Ikuti panduan favorit Microsoft Edge. Jika perlu, gunakan Favorites manager (⋯) untuk mengekspor favorit sebagai HTML.</string>
    <string name="import_guide_step1_title_naver_whale">1. Atur sinkronisasi Naver Whale terlebih dahulu</string>
    <string name="import_guide_step1_body_notice_naver_whale">Dokumentasi resmi Naver Whale berfokus pada sinkronisasi bookmark antar perangkat.</string>
    <string name="import_guide_step1_body_desktop_naver_whale">Ikuti panduan sinkronisasi Whale, lalu periksa bookmark manager Whale desktop untuk opsi ekspor HTML.</string>
    <string name="import_guide_step1_title_samsung_internet">1. Buka panduan bookmark Samsung Internet</string>
    <string name="import_guide_step1_body_notice_samsung_internet">Samsung Internet mungkin tidak menyediakan ekspor bookmark HTML langsung di seluler.</string>
    <string name="import_guide_step1_body_desktop_samsung_internet">Gunakan panduan bookmark/sinkronisasi Samsung Internet, lalu ekspor dari browser desktop jika diperlukan.</string>
    <string name="import_guide_step1_title_firefox">1. Ekspor di Firefox desktop</string>
    <string name="import_guide_step1_body_notice_firefox">Di Firefox seluler, ekspor bookmark mungkin tidak tersedia.</string>
    <string name="import_guide_step1_body_desktop_firefox">Di Firefox komputer Anda, buka Bookmarks > Manage bookmarks, lalu Import and Backup > Export Bookmarks to HTML.</string>
    <string name="import_guide_step1_title_safari">1. Ekspor di Safari Mac</string>
    <string name="import_guide_step1_body_notice_safari">Di Safari iPhone/iPad, ekspor bookmark langsung tidak tersedia.</string>
    <string name="import_guide_step1_body_desktop_safari">Di Safari Mac, buka File > Export > Bookmarks.</string>
    <string name="import_guide_step1_title_opera">1. Ekspor di Opera desktop</string>
    <string name="import_guide_step1_body_notice_opera">Di Opera seluler, ekspor bookmark mungkin tidak tersedia.</string>
    <string name="import_guide_step1_body_desktop_opera">Di Opera komputer Anda, buka Bookmarks manager dan gunakan Export bookmarks to HTML.</string>
    <string name="import_guide_step1_title_vivaldi">1. Ekspor di Vivaldi desktop</string>
    <string name="import_guide_step1_body_notice_vivaldi">Di Vivaldi seluler, ekspor bookmark mungkin tidak tersedia.</string>
    <string name="import_guide_step1_body_desktop_vivaldi">Di Vivaldi komputer Anda, buka Bookmarks manager dan ekspor bookmark sebagai HTML.</string>
    <string name="import_guide_step1_title_duckduckgo">1. Atur DuckDuckGo Sync dan Backup</string>
    <string name="import_guide_step1_body_notice_duckduckgo">Panduan resmi DuckDuckGo berfokus pada sinkronisasi/backup, bukan ekspor HTML.</string>
    <string name="import_guide_step1_body_desktop_duckduckgo">Gunakan panduan sinkronisasi DuckDuckGo, lalu pindahkan bookmark melalui browser desktop lain jika ekspor HTML diperlukan.</string>
    <string name="import_guide_step1_title_kiwi">1. Siapkan bookmark Kiwi untuk ekspor</string>
    <string name="import_guide_step1_body_notice_kiwi">Dokumentasi resmi Kiwi untuk ekspor bookmark HTML masih terbatas.</string>
    <string name="import_guide_step1_body_desktop_kiwi">Pindahkan bookmark ke browser desktop berbasis Chromium, lalu ekspor bookmark sebagai HTML.</string>
    <string name="import_guide_step1_title_yandex">1. Ekspor di Yandex Browser desktop</string>
    <string name="import_guide_step1_body_notice_yandex">Di Yandex Browser seluler, ekspor bookmark mungkin tidak tersedia.</string>
    <string name="import_guide_step1_body_desktop_yandex">Di Yandex Browser komputer Anda, buka Bookmarks manager dan ekspor bookmark sebagai HTML.</string>
    <string name="import_guide_step1_title_arc">1. Ikuti panduan impor/migrasi Arc</string>
    <string name="import_guide_step1_body_notice_arc">Panduan resmi Arc berfokus pada impor data dari browser lain.</string>
    <string name="import_guide_step1_body_desktop_arc">Gunakan panduan migrasi Arc terlebih dahulu. Jika ekspor HTML diperlukan, pindahkan data ke browser yang mendukung ekspor HTML.</string>
    <string name="import_guide_step1_title_ie">1. Ekspor favorit di Internet Explorer</string>
    <string name="import_guide_step1_body_notice_ie">Internet Explorer sudah usang dan mungkin tidak tersedia di perangkat Anda.</string>
    <string name="import_guide_step1_body_desktop_ie">Di Internet Explorer, buka Favorites > Import and Export, lalu ekspor favorit ke file.</string>

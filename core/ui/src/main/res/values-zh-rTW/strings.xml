    <string name="import_guide_step1_title">1. 在桌面版 Chrome 匯出</string>
    <string name="import_guide_step1_body_notice">在手機版 Chrome 上無法匯出書籤。</string>
    <string name="import_guide_step1_body_desktop">在電腦版 Chrome 中，開啟選單 (⋮) > Bookmarks and lists > Bookmark manager，接著選單 (⋮) > Export bookmarks。</string>
    <string name="import_guide_step1_body">在手機版 Chrome 上無法匯出書籤。在電腦版 Chrome 中，開啟選單 (⋮) > Bookmarks and lists > Bookmark manager，接著選單 (⋮) > Export bookmarks。</string>
    <string name="import_guide_step1_button">開啟瀏覽器教學</string>
    <string name="import_guide_step1_title_brave">1. 直接開啟 Brave 書籤</string>
    <string name="import_guide_step1_body_notice_brave">手機版 Brave 支援匯入與匯出書籤。</string>
    <string name="import_guide_step1_title_edge">1. 開啟 Microsoft Edge 我的最愛教學</string>
    <string name="import_guide_step1_body_notice_edge">手機版 Edge 可能不支援匯出書籤。</string>
    <string name="import_guide_step1_body_desktop_edge">請依照 Microsoft Edge 我的最愛教學操作。必要時可使用 Favorites manager (⋯) 將我的最愛匯出為 HTML。</string>
    <string name="import_guide_step1_title_naver_whale">1. 先設定 Naver Whale 同步</string>
    <string name="import_guide_step1_body_notice_naver_whale">Naver Whale 官方文件主要說明裝置間書籤同步。</string>
    <string name="import_guide_step1_body_desktop_naver_whale">依照 Whale 同步教學後，再到桌面版 Whale 書籤管理器查看 HTML 匯出選項。</string>
    <string name="import_guide_step1_title_samsung_internet">1. 開啟 Samsung Internet 書籤教學</string>
    <string name="import_guide_step1_body_notice_samsung_internet">Samsung Internet 在手機上可能不提供直接匯出 HTML 書籤。</string>
    <string name="import_guide_step1_body_desktop_samsung_internet">使用 Samsung Internet 書籤/同步教學，必要時再從桌面瀏覽器匯出。</string>
    <string name="import_guide_step1_title_firefox">1. 在桌面版 Firefox 匯出</string>
    <string name="import_guide_step1_body_notice_firefox">手機版 Firefox 可能不支援匯出書籤。</string>
    <string name="import_guide_step1_body_desktop_firefox">在電腦版 Firefox 中，開啟 Bookmarks > Manage bookmarks，再選 Import and Backup > Export Bookmarks to HTML。</string>
    <string name="import_guide_step1_title_safari">1. 在 Mac Safari 匯出</string>
    <string name="import_guide_step1_body_notice_safari">iPhone/iPad 的 Safari 不支援直接匯出書籤。</string>
    <string name="import_guide_step1_body_desktop_safari">在 Mac Safari 中，開啟 File > Export > Bookmarks。</string>
    <string name="import_guide_step1_title_opera">1. 在桌面版 Opera 匯出</string>
    <string name="import_guide_step1_body_notice_opera">手機版 Opera 可能不支援匯出書籤。</string>
    <string name="import_guide_step1_body_desktop_opera">在電腦版 Opera 中開啟 Bookmarks manager，並使用 Export bookmarks to HTML。</string>
    <string name="import_guide_step1_title_vivaldi">1. 在桌面版 Vivaldi 匯出</string>
    <string name="import_guide_step1_body_notice_vivaldi">手機版 Vivaldi 可能不支援匯出書籤。</string>
    <string name="import_guide_step1_body_desktop_vivaldi">在電腦版 Vivaldi 中開啟 Bookmarks manager，並將書籤匯出為 HTML。</string>
    <string name="import_guide_step1_title_duckduckgo">1. 設定 DuckDuckGo 同步與備份</string>
    <string name="import_guide_step1_body_notice_duckduckgo">DuckDuckGo 官方教學重點是同步/備份，而非 HTML 匯出。</string>
    <string name="import_guide_step1_body_desktop_duckduckgo">先使用 DuckDuckGo 同步教學，若需要 HTML 匯出，再透過其他桌面瀏覽器轉移書籤。</string>
    <string name="import_guide_step1_title_kiwi">1. 準備 Kiwi 書籤匯出</string>
    <string name="import_guide_step1_body_notice_kiwi">Kiwi 對 HTML 書籤匯出的官方文件較少。</string>
    <string name="import_guide_step1_body_desktop_kiwi">先將書籤移到桌面版 Chromium 系列瀏覽器，再匯出為 HTML。</string>
    <string name="import_guide_step1_title_yandex">1. 在桌面版 Yandex Browser 匯出</string>
    <string name="import_guide_step1_body_notice_yandex">手機版 Yandex Browser 可能不支援匯出書籤。</string>
    <string name="import_guide_step1_body_desktop_yandex">在電腦版 Yandex Browser 中開啟 Bookmarks manager，並將書籤匯出為 HTML。</string>
    <string name="import_guide_step1_title_arc">1. 依照 Arc 匯入/遷移教學</string>
    <string name="import_guide_step1_body_notice_arc">Arc 官方教學主要著重於從其他瀏覽器匯入資料。</string>
    <string name="import_guide_step1_body_desktop_arc">先使用 Arc 遷移教學。若需要 HTML 匯出，請將資料移至支援 HTML 匯出的瀏覽器。</string>
    <string name="import_guide_step1_title_ie">1. 在 Internet Explorer 匯出我的最愛</string>
    <string name="import_guide_step1_body_notice_ie">Internet Explorer 已淘汰，裝置上可能無法使用。</string>
    <string name="import_guide_step1_body_desktop_ie">在 Internet Explorer 中開啟 Favorites > Import and Export，將我的最愛匯出成檔案。</string>
    <string name="import_guide_step1_title_generic">1. 在桌面版 %1$s 匯出書籤</string>
    <string name="import_guide_step1_body_notice_generic">手機版 %1$s 可能不支援匯出書籤。</string>
    <string name="import_guide_step1_body_desktop_generic">在電腦版 %1$s 中找到 Bookmark/Favorites manager，並匯出為 HTML。</string>

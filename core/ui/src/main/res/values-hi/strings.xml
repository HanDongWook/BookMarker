    <string name="import_guide_step1_title">1. डेस्कटॉप Chrome पर एक्सपोर्ट करें</string>
    <string name="import_guide_step1_body_notice">मोबाइल Chrome पर बुकमार्क एक्सपोर्ट उपलब्ध नहीं है।</string>
    <string name="import_guide_step1_body_desktop">अपने कंप्यूटर के Chrome में मेनू (⋮) > Bookmarks and lists > Bookmark manager खोलें, फिर मेनू (⋮) > Export bookmarks चुनें।</string>
    <string name="import_guide_step1_body">मोबाइल Chrome पर बुकमार्क एक्सपोर्ट उपलब्ध नहीं है। अपने कंप्यूटर के Chrome में मेनू (⋮) > Bookmarks and lists > Bookmark manager खोलें, फिर मेनू (⋮) > Export bookmarks चुनें।</string>
    <string name="import_guide_step1_button">ब्राउज़र गाइड खोलें</string>
    <string name="import_guide_step1_title_brave">1. Brave बुकमार्क सीधे खोलें</string>
    <string name="import_guide_step1_body_notice_brave">मोबाइल Brave में बुकमार्क आयात/निर्यात समर्थित है।</string>
    <string name="import_guide_step1_title_edge">1. Microsoft Edge Favorites गाइड खोलें</string>
    <string name="import_guide_step1_body_notice_edge">मोबाइल Edge में बुकमार्क एक्सपोर्ट उपलब्ध न भी हो सकता है।</string>
    <string name="import_guide_step1_body_desktop_edge">Microsoft Edge Favorites गाइड का पालन करें। आवश्यकता होने पर Favorites manager (⋯) से HTML में एक्सपोर्ट करें।</string>
    <string name="import_guide_step1_title_naver_whale">1. पहले Naver Whale सिंक सेट करें</string>
    <string name="import_guide_step1_body_notice_naver_whale">Naver Whale का आधिकारिक दस्तावेज़ डिवाइसों के बीच बुकमार्क सिंक पर केंद्रित है।</string>
    <string name="import_guide_step1_body_desktop_naver_whale">Whale सिंक गाइड का पालन करें, फिर डेस्कटॉप Whale Bookmark Manager में HTML एक्सपोर्ट विकल्प देखें।</string>
    <string name="import_guide_step1_title_samsung_internet">1. Samsung Internet बुकमार्क गाइड खोलें</string>
    <string name="import_guide_step1_body_notice_samsung_internet">Samsung Internet मोबाइल पर सीधे HTML बुकमार्क एक्सपोर्ट न दे सकता है।</string>
    <string name="import_guide_step1_body_desktop_samsung_internet">Samsung Internet बुकमार्क/सिंक गाइड का उपयोग करें, और आवश्यकता होने पर डेस्कटॉप ब्राउज़र से एक्सपोर्ट करें।</string>
    <string name="import_guide_step1_title_firefox">1. डेस्कटॉप Firefox पर एक्सपोर्ट करें</string>
    <string name="import_guide_step1_body_notice_firefox">मोबाइल Firefox में बुकमार्क एक्सपोर्ट उपलब्ध न भी हो सकता है।</string>
    <string name="import_guide_step1_body_desktop_firefox">अपने कंप्यूटर के Firefox में Bookmarks > Manage bookmarks खोलें, फिर Import and Backup > Export Bookmarks to HTML चुनें।</string>
    <string name="import_guide_step1_title_safari">1. Mac Safari पर एक्सपोर्ट करें</string>
    <string name="import_guide_step1_body_notice_safari">iPhone/iPad Safari पर सीधे बुकमार्क एक्सपोर्ट उपलब्ध नहीं है।</string>
    <string name="import_guide_step1_body_desktop_safari">Mac Safari में File > Export > Bookmarks खोलें।</string>
    <string name="import_guide_step1_title_opera">1. डेस्कटॉप Opera पर एक्सपोर्ट करें</string>
    <string name="import_guide_step1_body_notice_opera">मोबाइल Opera में बुकमार्क एक्सपोर्ट उपलब्ध न भी हो सकता है।</string>
    <string name="import_guide_step1_body_desktop_opera">अपने कंप्यूटर के Opera में Bookmarks manager खोलें और Export bookmarks to HTML का उपयोग करें।</string>
    <string name="import_guide_step1_title_vivaldi">1. डेस्कटॉप Vivaldi पर एक्सपोर्ट करें</string>
    <string name="import_guide_step1_body_notice_vivaldi">मोबाइल Vivaldi में बुकमार्क एक्सपोर्ट उपलब्ध न भी हो सकता है।</string>
    <string name="import_guide_step1_body_desktop_vivaldi">अपने कंप्यूटर के Vivaldi में Bookmarks manager खोलें और HTML में एक्सपोर्ट करें।</string>
    <string name="import_guide_step1_title_duckduckgo">1. DuckDuckGo Sync और Backup सेट करें</string>
    <string name="import_guide_step1_body_notice_duckduckgo">DuckDuckGo की आधिकारिक गाइड HTML एक्सपोर्ट की बजाय sync/backup पर केंद्रित है।</string>
    <string name="import_guide_step1_body_desktop_duckduckgo">DuckDuckGo sync गाइड का उपयोग करें, फिर आवश्यकता होने पर HTML एक्सपोर्ट वाले डेस्कटॉप ब्राउज़र से बुकमार्क स्थानांतरित करें।</string>
    <string name="import_guide_step1_title_kiwi">1. Kiwi बुकमार्क को एक्सपोर्ट के लिए तैयार करें</string>
    <string name="import_guide_step1_body_notice_kiwi">Kiwi में HTML बुकमार्क एक्सपोर्ट के लिए आधिकारिक दस्तावेज़ सीमित है।</string>
    <string name="import_guide_step1_body_desktop_kiwi">बुकमार्क को Chromium-आधारित डेस्कटॉप ब्राउज़र में ले जाएँ और HTML में एक्सपोर्ट करें।</string>
    <string name="import_guide_step1_title_yandex">1. डेस्कटॉप Yandex Browser पर एक्सपोर्ट करें</string>
    <string name="import_guide_step1_body_notice_yandex">मोबाइल Yandex Browser में बुकमार्क एक्सपोर्ट उपलब्ध न भी हो सकता है।</string>
    <string name="import_guide_step1_body_desktop_yandex">अपने कंप्यूटर के Yandex Browser में Bookmarks manager खोलें और HTML में एक्सपोर्ट करें।</string>
    <string name="import_guide_step1_title_arc">1. Arc import/migration गाइड का पालन करें</string>
    <string name="import_guide_step1_body_notice_arc">Arc की आधिकारिक गाइड अन्य ब्राउज़र से डेटा आयात पर केंद्रित है।</string>
    <string name="import_guide_step1_body_desktop_arc">पहले Arc migration गाइड का उपयोग करें। यदि HTML एक्सपोर्ट चाहिए, तो डेटा ऐसे ब्राउज़र में ले जाएँ जो HTML एक्सपोर्ट सपोर्ट करता हो।</string>
    <string name="import_guide_step1_title_ie">1. Internet Explorer में Favorites एक्सपोर्ट करें</string>
    <string name="import_guide_step1_body_notice_ie">Internet Explorer अप्रचलित है और आपके डिवाइस पर उपलब्ध न भी हो सकता है।</string>
    <string name="import_guide_step1_body_desktop_ie">Internet Explorer में Favorites > Import and Export खोलें, फिर Favorites को फ़ाइल में एक्सपोर्ट करें।</string>
    <string name="import_guide_step1_title_generic">1. डेस्कटॉप %1$s में बुकमार्क एक्सपोर्ट करें</string>
    <string name="import_guide_step1_body_notice_generic">मोबाइल %1$s में बुकमार्क एक्सपोर्ट उपलब्ध न भी हो सकता है।</string>
    <string name="import_guide_step1_body_desktop_generic">अपने कंप्यूटर के %1$s में Bookmark/Favorites manager ढूँढें और HTML में एक्सपोर्ट करें।</string>

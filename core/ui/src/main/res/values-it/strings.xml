    <string name="import_guide_title_for_browser">Importa segnalibri di %1$s</string>
    <string name="import_guide_step1_title">1. Esporta da Chrome desktop</string>
    <string name="import_guide_step1_body_notice">Su Chrome mobile, l’esportazione dei segnalibri non è disponibile.</string>
    <string name="import_guide_step1_body_desktop">Sul Chrome del tuo computer, apri menu (⋮) > Bookmarks and lists > Bookmark manager, poi menu (⋮) > Export bookmarks.</string>
    <string name="import_guide_step1_body">Su Chrome mobile, l’esportazione dei segnalibri non è disponibile. Sul Chrome del tuo computer, apri menu (⋮) > Bookmarks and lists > Bookmark manager, poi menu (⋮) > Export bookmarks.</string>
    <string name="import_guide_step1_button">Apri guida del browser</string>
    <string name="import_guide_step1_title_brave">1. Apri direttamente i segnalibri di Brave</string>
    <string name="import_guide_step1_body_notice_brave">Brave su mobile supporta l’importazione e l’esportazione dei segnalibri.</string>
    <string name="import_guide_step1_title_edge">1. Apri guida dei preferiti di Microsoft Edge</string>
    <string name="import_guide_step1_body_notice_edge">Su Edge mobile, l’esportazione dei segnalibri potrebbe non essere disponibile.</string>
    <string name="import_guide_step1_body_desktop_edge">Segui la guida dei preferiti di Microsoft Edge. Se necessario, usa Favorites manager (⋯) per esportare i preferiti in HTML.</string>
    <string name="import_guide_step1_title_naver_whale">1. Configura prima la sincronizzazione di Naver Whale</string>
    <string name="import_guide_step1_body_notice_naver_whale">La documentazione ufficiale di Naver Whale si concentra sulla sincronizzazione dei segnalibri tra dispositivi.</string>
    <string name="import_guide_step1_body_desktop_naver_whale">Segui la guida di sincronizzazione Whale, poi controlla il gestore segnalibri di Whale desktop per le opzioni di esportazione HTML.</string>
    <string name="import_guide_step1_title_samsung_internet">1. Apri guida segnalibri di Samsung Internet</string>
    <string name="import_guide_step1_body_notice_samsung_internet">Samsung Internet potrebbe non offrire l’esportazione diretta dei segnalibri HTML su mobile.</string>
    <string name="import_guide_step1_body_desktop_samsung_internet">Usa la guida segnalibri/sincronizzazione di Samsung Internet, poi esporta da un browser desktop se necessario.</string>
    <string name="import_guide_step1_title_firefox">1. Esporta da Firefox desktop</string>
    <string name="import_guide_step1_body_notice_firefox">Su Firefox mobile, l’esportazione dei segnalibri potrebbe non essere disponibile.</string>
    <string name="import_guide_step1_body_desktop_firefox">Sul Firefox del tuo computer, apri Bookmarks > Manage bookmarks, poi Import and Backup > Export Bookmarks to HTML.</string>
    <string name="import_guide_step1_title_safari">1. Esporta da Safari su Mac</string>
    <string name="import_guide_step1_body_notice_safari">Su Safari per iPhone/iPad, l’esportazione diretta dei segnalibri non è disponibile.</string>
    <string name="import_guide_step1_body_desktop_safari">Su Safari per Mac, apri File > Export > Bookmarks.</string>
    <string name="import_guide_step1_title_opera">1. Esporta da Opera desktop</string>
    <string name="import_guide_step1_body_notice_opera">Su Opera mobile, l’esportazione dei segnalibri potrebbe non essere disponibile.</string>
    <string name="import_guide_step1_body_desktop_opera">Sul tuo Opera desktop, apri Bookmarks manager e usa Export bookmarks to HTML.</string>
    <string name="import_guide_step1_title_vivaldi">1. Esporta da Vivaldi desktop</string>
    <string name="import_guide_step1_body_notice_vivaldi">Su Vivaldi mobile, l’esportazione dei segnalibri potrebbe non essere disponibile.</string>
    <string name="import_guide_step1_body_desktop_vivaldi">Sul tuo Vivaldi desktop, apri Bookmarks manager ed esporta i segnalibri in HTML.</string>
    <string name="import_guide_step1_title_duckduckgo">1. Configura sincronizzazione e backup DuckDuckGo</string>
    <string name="import_guide_step1_body_notice_duckduckgo">La guida ufficiale DuckDuckGo si concentra su sincronizzazione/backup più che sull’esportazione HTML.</string>
    <string name="import_guide_step1_body_desktop_duckduckgo">Usa la guida di sincronizzazione DuckDuckGo, poi sposta i segnalibri tramite un altro browser desktop se serve l’esportazione HTML.</string>
    <string name="import_guide_step1_title_kiwi">1. Prepara i segnalibri Kiwi per l’esportazione</string>
    <string name="import_guide_step1_body_notice_kiwi">La documentazione ufficiale Kiwi per l’esportazione HTML dei segnalibri è limitata.</string>
    <string name="import_guide_step1_body_desktop_kiwi">Sposta i segnalibri in un browser desktop basato su Chromium, poi esportali in HTML.</string>
    <string name="import_guide_step1_title_yandex">1. Esporta da Yandex Browser desktop</string>
    <string name="import_guide_step1_body_notice_yandex">Su Yandex Browser mobile, l’esportazione dei segnalibri potrebbe non essere disponibile.</string>
    <string name="import_guide_step1_body_desktop_yandex">Sul tuo Yandex Browser desktop, apri Bookmarks manager ed esporta i segnalibri in HTML.</string>
    <string name="import_guide_step1_title_arc">1. Segui la guida import/migrazione di Arc</string>
    <string name="import_guide_step1_body_notice_arc">La guida ufficiale Arc è focalizzata sull’importazione di dati da altri browser.</string>
    <string name="import_guide_step1_body_desktop_arc">Usa prima la guida di migrazione Arc. Se è necessario l’export HTML, sposta i dati in un browser che lo supporti.</string>
    <string name="import_guide_step1_title_ie">1. Esporta i preferiti in Internet Explorer</string>
    <string name="import_guide_step1_body_notice_ie">Internet Explorer è deprecato e potrebbe non essere disponibile sul tuo dispositivo.</string>
    <string name="import_guide_step1_body_desktop_ie">In Internet Explorer, apri Favorites > Import and Export, poi esporta i preferiti in un file.</string>
    <string name="import_guide_step1_title_generic">1. Esporta i segnalibri su desktop %1$s</string>
    <string name="import_guide_step1_body_notice_generic">Su mobile %1$s, l’esportazione dei segnalibri potrebbe non essere disponibile.</string>
    <string name="import_guide_step1_body_desktop_generic">Sul tuo computer con %1$s, trova Bookmark/Favorites manager ed esporta in HTML.</string>
    <string name="import_guide_step2_title">2. Salva il file HTML sul telefono</string>

    <string name="import_guide_step1_title">1. 在桌面版 Chrome 导出</string>
    <string name="import_guide_step1_body_notice">在手机版 Chrome 上无法导出书签。</string>
    <string name="import_guide_step1_body_desktop">在电脑 Chrome 中，打开菜单 (⋮) > Bookmarks and lists > Bookmark manager，然后菜单 (⋮) > Export bookmarks。</string>
    <string name="import_guide_step1_body">在手机版 Chrome 上无法导出书签。在电脑 Chrome 中，打开菜单 (⋮) > Bookmarks and lists > Bookmark manager，然后菜单 (⋮) > Export bookmarks。</string>
    <string name="import_guide_step1_button">打开浏览器指南</string>
    <string name="import_guide_step1_title_brave">1. 直接打开 Brave 书签</string>
    <string name="import_guide_step1_body_notice_brave">手机版 Brave 支持导入和导出书签。</string>
    <string name="import_guide_step1_title_edge">1. 打开 Microsoft Edge 收藏夹指南</string>
    <string name="import_guide_step1_body_notice_edge">手机版 Edge 可能不支持导出书签。</string>
    <string name="import_guide_step1_body_desktop_edge">请按 Microsoft Edge 收藏夹指南操作。必要时可在 Favorites manager (⋯) 中将收藏夹导出为 HTML。</string>
    <string name="import_guide_step1_title_naver_whale">1. 先设置 Naver Whale 同步</string>
    <string name="import_guide_step1_body_notice_naver_whale">Naver Whale 官方文档主要说明设备间书签同步。</string>
    <string name="import_guide_step1_body_desktop_naver_whale">按照 Whale 同步指南操作后，在桌面版 Whale 书签管理器中查看 HTML 导出选项。</string>
    <string name="import_guide_step1_title_samsung_internet">1. 打开 Samsung Internet 书签指南</string>
    <string name="import_guide_step1_body_notice_samsung_internet">Samsung Internet 在手机上可能不提供直接导出 HTML 书签。</string>
    <string name="import_guide_step1_body_desktop_samsung_internet">使用 Samsung Internet 书签/同步指南，必要时再从桌面浏览器导出。</string>
    <string name="import_guide_step1_title_firefox">1. 在桌面版 Firefox 导出</string>
    <string name="import_guide_step1_body_notice_firefox">手机版 Firefox 可能不支持导出书签。</string>
    <string name="import_guide_step1_body_desktop_firefox">在电脑 Firefox 中，打开 Bookmarks > Manage bookmarks，然后选择 Import and Backup > Export Bookmarks to HTML。</string>
    <string name="import_guide_step1_title_safari">1. 在 Mac Safari 导出</string>
    <string name="import_guide_step1_body_notice_safari">iPhone/iPad Safari 不支持直接导出书签。</string>
    <string name="import_guide_step1_body_desktop_safari">在 Mac Safari 中，打开 File > Export > Bookmarks。</string>
    <string name="import_guide_step1_title_opera">1. 在桌面版 Opera 导出</string>
    <string name="import_guide_step1_body_notice_opera">手机版 Opera 可能不支持导出书签。</string>
    <string name="import_guide_step1_body_desktop_opera">在电脑 Opera 中打开 Bookmarks manager，并使用 Export bookmarks to HTML。</string>
    <string name="import_guide_step1_title_vivaldi">1. 在桌面版 Vivaldi 导出</string>
    <string name="import_guide_step1_body_notice_vivaldi">手机版 Vivaldi 可能不支持导出书签。</string>
    <string name="import_guide_step1_body_desktop_vivaldi">在电脑 Vivaldi 中打开 Bookmarks manager，并将书签导出为 HTML。</string>
    <string name="import_guide_step1_title_duckduckgo">1. 设置 DuckDuckGo 同步和备份</string>
    <string name="import_guide_step1_body_notice_duckduckgo">DuckDuckGo 官方指南更侧重同步/备份，而非 HTML 导出。</string>
    <string name="import_guide_step1_body_desktop_duckduckgo">先使用 DuckDuckGo 同步指南，如需 HTML 导出，再通过其他桌面浏览器迁移书签。</string>
    <string name="import_guide_step1_title_kiwi">1. 准备导出 Kiwi 书签</string>
    <string name="import_guide_step1_body_notice_kiwi">Kiwi 关于 HTML 书签导出的官方文档较少。</string>
    <string name="import_guide_step1_body_desktop_kiwi">先将书签移动到基于 Chromium 的桌面浏览器，再导出为 HTML。</string>
    <string name="import_guide_step1_title_yandex">1. 在桌面版 Yandex Browser 导出</string>
    <string name="import_guide_step1_body_notice_yandex">手机版 Yandex Browser 可能不支持导出书签。</string>
    <string name="import_guide_step1_body_desktop_yandex">在电脑 Yandex Browser 中打开 Bookmarks manager，并将书签导出为 HTML。</string>
    <string name="import_guide_step1_title_arc">1. 按照 Arc 导入/迁移指南</string>
    <string name="import_guide_step1_body_notice_arc">Arc 官方指南主要聚焦从其他浏览器导入数据。</string>
    <string name="import_guide_step1_body_desktop_arc">先使用 Arc 迁移指南。如需 HTML 导出，请将数据转移到支持 HTML 导出的浏览器。</string>
    <string name="import_guide_step1_title_ie">1. 在 Internet Explorer 导出收藏夹</string>
    <string name="import_guide_step1_body_notice_ie">Internet Explorer 已弃用，您的设备上可能不可用。</string>
    <string name="import_guide_step1_body_desktop_ie">在 Internet Explorer 中打开 Favorites > Import and Export，然后将收藏夹导出到文件。</string>
    <string name="import_guide_step1_title_generic">1. 在桌面版 %1$s 导出书签</string>
    <string name="import_guide_step1_body_notice_generic">手机版 %1$s 可能不支持导出书签。</string>
    <string name="import_guide_step1_body_desktop_generic">在电脑 %1$s 中找到 Bookmark/Favorites manager 并导出为 HTML。</string>
    <string name="import_guide_step2_title">2. 将 HTML 文件保存到手机</string>

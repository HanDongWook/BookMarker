    <string name="import_guide_title_for_browser">Importer les signets de %1$s</string>
    <string name="import_guide_step1_title">1. Exporter depuis Chrome sur ordinateur</string>
    <string name="import_guide_step1_body_notice">Sur Chrome mobile, l’exportation des signets n’est pas disponible.</string>
    <string name="import_guide_step1_body_desktop">Sur Chrome ordinateur, ouvrez menu (⋮) > Bookmarks and lists > Bookmark manager, puis menu (⋮) > Export bookmarks.</string>
    <string name="import_guide_step1_body">Sur Chrome mobile, l’exportation des signets n’est pas disponible. Sur Chrome ordinateur, ouvrez menu (⋮) > Bookmarks and lists > Bookmark manager, puis menu (⋮) > Export bookmarks.</string>
    <string name="import_guide_step1_button">Ouvrir le guide du navigateur</string>
    <string name="import_guide_step1_title_brave">1. Ouvrir directement les signets Brave</string>
    <string name="import_guide_step1_body_notice_brave">Brave sur mobile prend en charge l’import et l’export des signets.</string>
    <string name="import_guide_step1_title_edge">1. Ouvrir le guide des favoris Microsoft Edge</string>
    <string name="import_guide_step1_body_notice_edge">Sur Edge mobile, l’exportation des signets peut ne pas être disponible.</string>
    <string name="import_guide_step1_body_desktop_edge">Suivez le guide des favoris Microsoft Edge. Si nécessaire, utilisez Favorites manager (⋯) pour exporter les favoris en HTML.</string>
    <string name="import_guide_step1_title_naver_whale">1. Configurer d’abord la synchronisation Naver Whale</string>
    <string name="import_guide_step1_body_notice_naver_whale">La documentation officielle de Naver Whale se concentre sur la synchronisation des signets entre appareils.</string>
    <string name="import_guide_step1_body_desktop_naver_whale">Suivez le guide de synchronisation Whale, puis vérifiez le gestionnaire de signets Whale sur ordinateur pour les options d’export HTML.</string>
    <string name="import_guide_step1_title_samsung_internet">1. Ouvrir le guide des signets Samsung Internet</string>
    <string name="import_guide_step1_body_notice_samsung_internet">Samsung Internet peut ne pas proposer l’export direct des signets HTML sur mobile.</string>
    <string name="import_guide_step1_body_desktop_samsung_internet">Utilisez le guide Samsung Internet des signets/synchronisation, puis exportez depuis un navigateur de bureau si nécessaire.</string>
    <string name="import_guide_step1_title_firefox">1. Exporter depuis Firefox sur ordinateur</string>
    <string name="import_guide_step1_body_notice_firefox">Sur Firefox mobile, l’exportation des signets peut ne pas être disponible.</string>
    <string name="import_guide_step1_body_desktop_firefox">Sur Firefox ordinateur, ouvrez Bookmarks > Manage bookmarks, puis Import and Backup > Export Bookmarks to HTML.</string>
    <string name="import_guide_step1_title_safari">1. Exporter depuis Safari sur Mac</string>
    <string name="import_guide_step1_body_notice_safari">Sur Safari iPhone/iPad, l’exportation directe des signets n’est pas disponible.</string>
    <string name="import_guide_step1_body_desktop_safari">Sur Safari Mac, ouvrez File > Export > Bookmarks.</string>
    <string name="import_guide_step1_title_opera">1. Exporter depuis Opera sur ordinateur</string>
    <string name="import_guide_step1_body_notice_opera">Sur Opera mobile, l’exportation des signets peut ne pas être disponible.</string>
    <string name="import_guide_step1_body_desktop_opera">Sur Opera ordinateur, ouvrez Bookmarks manager et utilisez Export bookmarks to HTML.</string>
    <string name="import_guide_step1_title_vivaldi">1. Exporter depuis Vivaldi sur ordinateur</string>
    <string name="import_guide_step1_body_notice_vivaldi">Sur Vivaldi mobile, l’exportation des signets peut ne pas être disponible.</string>
    <string name="import_guide_step1_body_desktop_vivaldi">Sur Vivaldi ordinateur, ouvrez Bookmarks manager et exportez les signets en HTML.</string>
    <string name="import_guide_step1_title_duckduckgo">1. Configurer la synchronisation et la sauvegarde DuckDuckGo</string>
    <string name="import_guide_step1_body_notice_duckduckgo">Le guide officiel DuckDuckGo est axé sur la synchronisation/sauvegarde plutôt que l’export HTML.</string>
    <string name="import_guide_step1_body_desktop_duckduckgo">Utilisez le guide de synchronisation DuckDuckGo, puis transférez les signets via un autre navigateur de bureau si l’export HTML est nécessaire.</string>
    <string name="import_guide_step1_title_kiwi">1. Préparer les signets Kiwi pour l’export</string>
    <string name="import_guide_step1_body_notice_kiwi">La documentation officielle Kiwi pour l’export HTML des signets est limitée.</string>
    <string name="import_guide_step1_body_desktop_kiwi">Déplacez les signets vers un navigateur de bureau basé sur Chromium, puis exportez-les en HTML.</string>
    <string name="import_guide_step1_title_yandex">1. Exporter depuis Yandex Browser sur ordinateur</string>
    <string name="import_guide_step1_body_notice_yandex">Sur Yandex Browser mobile, l’exportation des signets peut ne pas être disponible.</string>
    <string name="import_guide_step1_body_desktop_yandex">Sur Yandex Browser ordinateur, ouvrez Bookmarks manager et exportez les signets en HTML.</string>
    <string name="import_guide_step1_title_arc">1. Suivre le guide d’import/migration Arc</string>
    <string name="import_guide_step1_body_notice_arc">Le guide officiel Arc se concentre sur l’import de données depuis d’autres navigateurs.</string>
    <string name="import_guide_step1_body_desktop_arc">Utilisez d’abord le guide de migration Arc. Si l’export HTML est nécessaire, déplacez les données vers un navigateur qui le prend en charge.</string>
    <string name="import_guide_step1_title_ie">1. Exporter les favoris dans Internet Explorer</string>
    <string name="import_guide_step1_body_notice_ie">Internet Explorer est obsolète et peut ne pas être disponible sur votre appareil.</string>
    <string name="import_guide_step1_body_desktop_ie">Dans Internet Explorer, ouvrez Favorites > Import and Export, puis exportez les favoris vers un fichier.</string>
    <string name="import_guide_step1_title_generic">1. Exporter les signets sur %1$s ordinateur</string>
    <string name="import_guide_step1_body_notice_generic">Sur %1$s mobile, l’exportation des signets peut ne pas être disponible.</string>
    <string name="import_guide_step1_body_desktop_generic">Sur votre ordinateur avec %1$s, trouvez Bookmark/Favorites manager et exportez en HTML.</string>
    <string name="import_guide_step2_title">2. Enregistrer le fichier HTML sur le téléphone</string>

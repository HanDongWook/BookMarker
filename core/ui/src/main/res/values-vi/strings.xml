    <string name="import_guide_step1_title">1. Xuất trên Chrome máy tính</string>
    <string name="import_guide_step1_body_notice">Trên Chrome di động, không thể xuất dấu trang.</string>
    <string name="import_guide_step1_body_desktop">Trên Chrome máy tính của bạn, mở menu (⋮) > Bookmarks and lists > Bookmark manager, sau đó menu (⋮) > Export bookmarks.</string>
    <string name="import_guide_step1_body">Trên Chrome di động, không thể xuất dấu trang. Trên Chrome máy tính của bạn, mở menu (⋮) > Bookmarks and lists > Bookmark manager, sau đó menu (⋮) > Export bookmarks.</string>
    <string name="import_guide_step1_button">Mở hướng dẫn trình duyệt</string>
    <string name="import_guide_step1_title_brave">1. Mở trực tiếp dấu trang Brave</string>
    <string name="import_guide_step1_body_notice_brave">Brave trên di động hỗ trợ nhập và xuất dấu trang.</string>
    <string name="import_guide_step1_title_edge">1. Mở hướng dẫn Favorites của Microsoft Edge</string>
    <string name="import_guide_step1_body_notice_edge">Trên Edge di động, có thể không hỗ trợ xuất dấu trang.</string>
    <string name="import_guide_step1_body_desktop_edge">Làm theo hướng dẫn Favorites của Microsoft Edge. Nếu cần, dùng Favorites manager (⋯) để xuất Favorites sang HTML.</string>
    <string name="import_guide_step1_title_naver_whale">1. Thiết lập đồng bộ Naver Whale trước</string>
    <string name="import_guide_step1_body_notice_naver_whale">Tài liệu chính thức của Naver Whale tập trung vào đồng bộ dấu trang giữa các thiết bị.</string>
    <string name="import_guide_step1_body_desktop_naver_whale">Làm theo hướng dẫn đồng bộ Whale, sau đó kiểm tra trình quản lý dấu trang Whale trên máy tính để tìm tùy chọn xuất HTML.</string>
    <string name="import_guide_step1_title_samsung_internet">1. Mở hướng dẫn dấu trang Samsung Internet</string>
    <string name="import_guide_step1_body_notice_samsung_internet">Samsung Internet có thể không hỗ trợ xuất trực tiếp dấu trang HTML trên di động.</string>
    <string name="import_guide_step1_body_desktop_samsung_internet">Dùng hướng dẫn dấu trang/đồng bộ của Samsung Internet, sau đó xuất từ trình duyệt máy tính nếu cần.</string>
    <string name="import_guide_step1_title_firefox">1. Xuất trên Firefox máy tính</string>
    <string name="import_guide_step1_body_notice_firefox">Trên Firefox di động, có thể không hỗ trợ xuất dấu trang.</string>
    <string name="import_guide_step1_body_desktop_firefox">Trên Firefox máy tính của bạn, mở Bookmarks > Manage bookmarks, rồi Import and Backup > Export Bookmarks to HTML.</string>
    <string name="import_guide_step1_title_safari">1. Xuất trên Safari Mac</string>
    <string name="import_guide_step1_body_notice_safari">Safari trên iPhone/iPad không hỗ trợ xuất trực tiếp dấu trang.</string>
    <string name="import_guide_step1_body_desktop_safari">Trên Safari Mac, mở File > Export > Bookmarks.</string>
    <string name="import_guide_step1_title_opera">1. Xuất trên Opera máy tính</string>
    <string name="import_guide_step1_body_notice_opera">Trên Opera di động, có thể không hỗ trợ xuất dấu trang.</string>
    <string name="import_guide_step1_body_desktop_opera">Trên Opera máy tính của bạn, mở Bookmarks manager và dùng Export bookmarks to HTML.</string>
    <string name="import_guide_step1_title_vivaldi">1. Xuất trên Vivaldi máy tính</string>
    <string name="import_guide_step1_body_notice_vivaldi">Trên Vivaldi di động, có thể không hỗ trợ xuất dấu trang.</string>
    <string name="import_guide_step1_body_desktop_vivaldi">Trên Vivaldi máy tính của bạn, mở Bookmarks manager và xuất dấu trang dưới dạng HTML.</string>
    <string name="import_guide_step1_title_duckduckgo">1. Thiết lập DuckDuckGo Sync và Backup</string>
    <string name="import_guide_step1_body_notice_duckduckgo">Hướng dẫn chính thức của DuckDuckGo tập trung vào đồng bộ/sao lưu hơn là xuất HTML.</string>
    <string name="import_guide_step1_body_desktop_duckduckgo">Dùng hướng dẫn đồng bộ DuckDuckGo, rồi chuyển dấu trang qua trình duyệt máy tính khác nếu cần xuất HTML.</string>
    <string name="import_guide_step1_title_kiwi">1. Chuẩn bị dấu trang Kiwi để xuất</string>
    <string name="import_guide_step1_body_notice_kiwi">Tài liệu chính thức của Kiwi về xuất dấu trang HTML còn hạn chế.</string>
    <string name="import_guide_step1_body_desktop_kiwi">Chuyển dấu trang sang trình duyệt máy tính dựa trên Chromium, rồi xuất dưới dạng HTML.</string>
    <string name="import_guide_step1_title_yandex">1. Xuất trên Yandex Browser máy tính</string>
    <string name="import_guide_step1_body_notice_yandex">Trên Yandex Browser di động, có thể không hỗ trợ xuất dấu trang.</string>
    <string name="import_guide_step1_body_desktop_yandex">Trên Yandex Browser máy tính của bạn, mở Bookmarks manager và xuất dấu trang dưới dạng HTML.</string>
    <string name="import_guide_step1_title_arc">1. Làm theo hướng dẫn nhập/chuyển dữ liệu của Arc</string>
    <string name="import_guide_step1_body_notice_arc">Hướng dẫn chính thức của Arc tập trung vào nhập dữ liệu từ trình duyệt khác.</string>
    <string name="import_guide_step1_body_desktop_arc">Hãy dùng hướng dẫn migration của Arc trước. Nếu cần xuất HTML, hãy chuyển dữ liệu sang trình duyệt hỗ trợ xuất HTML.</string>
    <string name="import_guide_step1_title_ie">1. Xuất Favorites trên Internet Explorer</string>
    <string name="import_guide_step1_body_notice_ie">Internet Explorer đã lỗi thời và có thể không còn trên thiết bị của bạn.</string>
    <string name="import_guide_step1_body_desktop_ie">Trong Internet Explorer, mở Favorites > Import and Export, rồi xuất Favorites ra tệp.</string>
    <string name="import_guide_step1_title_generic">1. Xuất dấu trang trên %1$s máy tính</string>
